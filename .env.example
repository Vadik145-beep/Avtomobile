# ── Telegram ───────────────────────────────────────────────
BOT_TOKEN=

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_DB=avto_lead
POSTGRES_USER=avto_lead
POSTGRES_PASSWORD=

DATABASE_URL=postgresql+asyncpg://avto_lead:${POSTGRES_PASSWORD}@postgres:5432/avto_lead

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── FastAPI ─────────────────────────────────────────────────
SECRET_KEY=
ADMIN_JWT_EXPIRE_HOURS=8

# ── Admin credentials ────────────────────────────────────────
ADMIN_USERNAME=admin
# Generate hash: python -c "from passlib.context import CryptContext; print(CryptContext(['bcrypt']).hash('yourpassword'))"
ADMIN_PASSWORD_HASH=

# ── Webhook / Internal secrets ───────────────────────────────
# Bearer-токен для POST /webhook/lidozvon (от Лидозвон)
LIDOZVON_SECRET=
# Bearer-токен для внутренних вызовов бота → бэкенд
BOT_INTERNAL_SECRET=

# Public domain (used for Telegram webhook URL)
DOMAIN=https://zayavki-auto.ru

# ── Mini App ────────────────────────────────────────────────
# URL Mini App (Telegram WebApp requires HTTPS)
MINIAPP_URL=https://mini-app.zayavki-auto.ru

# ── Payments (stub, extend later) ──────────────────────────
PAYMENT_PROVIDER=stub
